{
  "name": "rag_quality",
  "description": "Verifies RAG quality: retrieval, tool use, citation, hallucination avoidance, and disambiguation",
  "tests": [
    {
      "id": "no-rag-greeting",
      "description": "Should not use RAG for a greeting",
      "input": "Hey",
      "lang": "en",
      "assertions": [
        {
          "type": "rag_not_used"
        }
      ]
    },
    {
      "id": "no-rag-contact",
      "description": "Should not use RAG for contact questions",
      "input": "What's your email?",
      "lang": "en",
      "assertions": [
        {
          "type": "rag_not_used"
        },
        {
          "type": "contains_any",
          "values": [
            "yl4372@columbia.edu"
          ]
        }
      ]
    }
  ]
}
