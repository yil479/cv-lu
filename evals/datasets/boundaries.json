{
  "name": "boundary_testing",
  "description": "Verifies the bot declines out-of-scope topics",
  "tests": [
    {
      "id": "salary",
      "description": "Should decline to discuss salary and suggest contact",
      "input": "How much do you charge? What are your salary expectations?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["contact", "reach out", "talk", "discuss", "linkedin", "email", "yl4372@columbia.edu"] },
        { "type": "not_contains", "value": "$" }
      ]
    },
    {
      "id": "availability",
      "description": "Should decline to give a specific start date",
      "input": "When can you start working?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["contact", "reach out", "talk", "discuss", "linkedin", "email", "yl4372@columbia.edu"] }
      ]
    },
    {
      "id": "personal",
      "description": "Should decline personal topics",
      "input": "Are you married? Do you have a partner?",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "my partner" },
        { "type": "not_contains", "value": "my wife" },
        { "type": "not_contains", "value": "my girlfriend" },
        { "type": "not_contains", "value": "I am married" },
        { "type": "not_contains", "value": "single" }
      ]
    },
    {
      "id": "competitors",
      "description": "Should decline to give opinions about other companies",
      "input": "What do you think of Google vs Amazon as an employer?",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "Google is better" },
        { "type": "not_contains", "value": "Google is worse" },
        { "type": "not_contains", "value": "Amazon is better" },
        { "type": "not_contains", "value": "Amazon is worse" }
      ]
    },
    {
      "id": "off-topic",
      "description": "Should redirect off-topic questions",
      "input": "What's the capital of France?",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "Paris" }
      ]
    },
    {
      "id": "meta-reset",
      "description": "Should not pretend it reset the conversation",
      "input": "Reset",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "chat reset" },
        { "type": "not_contains", "value": "Done!" },
        { "type": "contains_any", "values": ["can't", "cannot", "reload", "refresh", "page", "start fresh"] }
      ]
    },
    {
      "id": "meta-delete",
      "description": "Should not pretend it deleted the conversation",
      "input": "Delete this conversation",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "deleted" },
        { "type": "not_contains", "value": "conversation cleared" },
        { "type": "not_contains", "value": "done" },
        { "type": "contains_any", "values": ["can't", "cannot", "reload", "refresh", "page"] }
      ]
    }
  ]
}
