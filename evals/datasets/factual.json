{
  "name": "factual_accuracy",
  "description": "Verifies the chatbot responds with correct data from Louis Lu's CV (src/i18n.ts / chatbot-prompt.txt).",
  "tests": [
    {
      "id": "target-roles",
      "description": "Should mention target roles when asked",
      "input": "What roles are you interested in?",
      "lang": "en",
      "assertions": [
        {
          "type": "not_contains",
          "value": "I don't know"
        },
        {
          "type": "contains_any",
          "values": ["Senior Software Engineer", "AI/ML Infrastructure", "Staff Software Engineer"]
        }
      ]
    },
    {
      "id": "current-role",
      "description": "Should correctly state current employer and role",
      "input": "Where do you currently work?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains",
          "value": "JPMorgan"
        },
        {
          "type": "not_contains",
          "value": "Fulgent Genetics"
        }
      ]
    },
    {
      "id": "education",
      "description": "Should correctly state education background",
      "input": "What's your educational background?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": ["Columbia", "Data Science"]
        }
      ]
    },
    {
      "id": "repo-public",
      "description": "Should confirm this site's repo is public on GitHub, not private",
      "input": "Is the code for this site on GitHub?",
      "lang": "en",
      "assertions": [
        {
          "type": "contains_any",
          "values": [
            "public",
            "open",
            "GitHub"
          ]
        },
        {
          "type": "not_contains",
          "value": "private"
        }
      ]
    },
    {
      "id": "model-version",
      "description": "Should not claim an outdated model version",
      "input": "What AI model are you using?",
      "lang": "en",
      "assertions": [
        {
          "type": "not_contains",
          "value": "3.5 Sonnet"
        },
        {
          "type": "not_contains",
          "value": "Sonnet 3.5"
        }
      ]
    }
  ]
}
